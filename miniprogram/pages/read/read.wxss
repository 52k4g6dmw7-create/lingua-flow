/* pages/read/read.wxss */

.read-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f8ef 0%, #f7f8fa 40%);
  padding-bottom: 400rpx;
}

/* ===== 自定义导航栏 ===== */
.read-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: transparent;
}

.read-navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
}

.nav-back,
.nav-home {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
  font-size: 44rpx;
  color: var(--text-primary);
}

.nav-back {
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.title-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.status-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-prepare {
  background-color: #ffffff;
  color: var(--text-secondary);
}

.status-recording {
  background-color: #fdecea;
  color: #e74c3c;
}

.status-analyzing {
  background-color: #e8f4fc;
  color: #3498db;
}

.status-complete {
  background-color: var(--primary-light);
  color: var(--primary-dark);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: currentColor;
}

.status-recording .status-dot {
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* ===== 页面内容 ===== */
.read-content {
  padding: 180rpx 32rpx 0;
}

/* ===== 内容语言选择 ===== */
.content-lang-bar {
  margin-bottom: 32rpx;
}

.lang-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  margin-bottom: 16rpx;
}

.lang-scroll {
  white-space: nowrap;
  width: 100%;
}

.lang-scroll-inner {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 32rpx;
}

.lang-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.lang-chip.active {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  border-color: var(--primary-dark);
  box-shadow: 0 4rpx 16rpx rgba(46, 204, 113, 0.35);
}

.lang-chip.active .chip-text {
  color: #ffffff;
}

.chip-flag {
  font-size: 32rpx;
}

.chip-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

/* ===== 句子进度 ===== */
.sentence-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.progress-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-dark);
}

.progress-dots {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.p-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #ffffff;
  border: 2rpx solid var(--border-color);
  transition: all 0.2s;
}

.p-dot.done {
  background-color: var(--primary-color);
  border-color: var(--primary-color);
}

.p-dot.current {
  background-color: var(--primary-color);
  border-color: var(--primary-color);
  transform: scale(1.3);
  box-shadow: 0 0 0 6rpx var(--primary-light);
}

/* ===== 朗读内容卡片 ===== */
.sentence-card {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.sentence-card::before {
  content: '"';
  position: absolute;
  top: -20rpx;
  left: 20rpx;
  font-size: 200rpx;
  color: var(--primary-light);
  font-family: Georgia, serif;
  line-height: 1;
  z-index: 0;
}

.sentence-number {
  position: relative;
  z-index: 1;
  display: inline-block;
  padding: 6rpx 20rpx;
  background-color: var(--primary-light);
  color: var(--primary-dark);
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.sentence-text {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  line-height: 1.7;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* ===== 录音计时卡片 ===== */
.timer-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.timer-display {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.timer-icon {
  font-size: 36rpx;
}

.timer-text {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary-dark);
  font-family: -apple-system, monospace;
  letter-spacing: 2rpx;
}

/* 波形动画 */
.wave-container {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
  height: 80rpx;
}

.wave-bar {
  width: 8rpx;
  background: linear-gradient(180deg, var(--primary-color), var(--primary-dark));
  border-radius: 4rpx;
  animation: wave 0.8s ease-in-out infinite;
}

@keyframes wave {
  0%, 100% { height: 12rpx; }
  50% { height: 80rpx; }
}

/* ===== 结果卡片 ===== */
.result-card {
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 204, 113, 0.12);
  border: 2rpx solid var(--primary-light);
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.total-score {
  display: flex;
  align-items: baseline;
}

.score-num {
  font-size: 64rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--primary-color), #f39c12);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
}

.score-unit {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-left: 6rpx;
}

.result-scores {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.score-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.score-label {
  width: 130rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.score-bar {
  flex: 1;
  height: 14rpx;
  background-color: #f2f2f2;
  border-radius: 7rpx;
  overflow: hidden;
}

.score-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.6s ease;
}

.score-fill-acc {
  background: linear-gradient(90deg, #3498db, #2ecc71);
}

.score-fill-flu {
  background: linear-gradient(90deg, #9b59b6, #3498db);
}

.score-value {
  width: 60rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}

/* ===== IELTS 雅思报告 ===== */
.ielts-report {
  background: linear-gradient(180deg, rgba(30, 60, 114, 0.04), #ffffff 70%);
  border: 2rpx solid #e9eefb;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 32rpx;
}
.ielts-report-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.ielts-band-badge {
  display: flex;
  flex-direction: column;
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.12);
}
.ielts-band-text {
  font-size: 20rpx;
  opacity: 0.9;
  letter-spacing: 0.5rpx;
  font-weight: 600;
}
.ielts-band-score {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  line-height: 1.1;
  margin-top: 4rpx;
}
.ielts-band-range {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}
.ielts-four-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.ielts-dim {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.dim-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 600;
}
.dim-bar {
  height: 10rpx;
  border-radius: 5rpx;
  background: #f2f2f2;
  overflow: hidden;
}
.dim-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.5s ease;
}
.dim-value {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.dim-sub {
  font-size: 20rpx;
  color: var(--text-hint);
  font-weight: 500;
  margin-left: 4rpx;
}
.ielts-next-step {
  background: #fff8e6;
  border-radius: 18rpx;
  padding: 22rpx;
  border-left: 6rpx solid #f39c12;
}
.next-step-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #b7780b;
  margin-bottom: 10rpx;
}
.next-step-text {
  font-size: 24rpx;
  color: #6e5509;
  line-height: 1.7;
  white-space: pre-wrap;
}

.suggestion-box {
  background-color: #fefcf2;
  border-radius: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid #f39c12;
}

.suggestion-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #d68910;
  margin-bottom: 10rpx;
}

.suggestion-text {
  font-size: 26rpx;
  color: #7d6608;
  line-height: 1.6;
}

/* ===== 提示卡片 ===== */
.tips-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
}

.tip-item + .tip-item {
  border-top: 1rpx dashed var(--border-color);
  padding-top: 20rpx;
}

.tip-bullet {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: var(--primary-light);
  color: var(--primary-dark);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tip-item text:last-child {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ===== 底部操作区 ===== */
.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 248, 250, 0) 0%, #f7f8fa 30%);
  z-index: 99;
}

.sentence-nav {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.nav-btn-small {
  padding: 12rpx 28rpx;
  background-color: #ffffff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.main-action {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 录音按钮 */
.record-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 360rpx;
  min-height: 160rpx;
  border-radius: 80rpx;
  gap: 10rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(46, 204, 113, 0.35);
}

.record-btn::after {
  border: none;
}

.record-btn-start {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
}

.record-btn-start:active {
  transform: scale(0.97);
}

.record-btn-stop {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  box-shadow: 0 12rpx 32rpx rgba(231, 76, 60, 0.4);
}

.record-btn-analyzing {
  background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
  box-shadow: 0 12rpx 32rpx rgba(52, 152, 219, 0.4);
}

.record-icon {
  font-size: 56rpx;
  line-height: 1;
}

.record-btn-stop .record-icon {
  font-size: 48rpx;
}

.pulse {
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.15); opacity: 0.8; }
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 完成后的操作按钮 */
.complete-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

.replay-btn {
  flex: 1;
  min-height: 96rpx;
  font-size: 28rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.replay-btn::after {
  border: none;
}

.next-btn {
  flex: 1.2;
  min-height: 96rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.next-btn::after {
  border: none;
}
