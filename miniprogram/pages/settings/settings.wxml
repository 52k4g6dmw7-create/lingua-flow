<!--pages/settings/settings.wxml-->
<view class="settings-page">
  <!-- 页面头部 用户信息区 -->
  <view class="header-area">
    <view class="user-card" bindtap="onTapUserCard">
      <view class="user-avatar">
        <block wx:if="{{isLoggedIn && userInfo.avatarUrl}}">
          <image src="{{userInfo.avatarUrl}}" class="avatar-img" mode="aspectFill" />
        </block>
        <block wx:elif="{{isLoggedIn}}">
          <text class="avatar-icon">😊</text>
        </block>
        <block wx:else>
          <text class="avatar-icon">👤</text>
        </block>
      </view>
      <view class="user-info">
        <block wx:if="{{isLoggedIn}}">
          <text class="user-name">{{userInfo.nickName || 'LinguaSpeak 用户'}}</text>
          <view class="user-desc-wrap">
            <text class="user-desc">
              {{locale.settings.proTip}}
            </text>
            <text wx:if="{{userInfo.phone}}" class="user-desc phone-tag">📱 {{userInfo.phone}}</text>
          </view>
        </block>
        <block wx:else>
          <text class="user-name login-text">{{locale.settings.login}} / {{locale.settings.register}}</text>
          <text class="user-desc">{{locale.common.appDesc}}</text>
        </block>
      </view>
      <view wx:if="{{!isLoggedIn}}" class="user-arrow">›</view>
      <view wx:elif="{{cloudReady}}" class="badge">ONLINE</view>
      <view wx:else class="badge badge-local">LOCAL</view>
    </view>
  </view>

  <view class="settings-content">
    <!-- 账号安全组（登录后才显示） -->
    <view wx:if="{{isLoggedIn}}" class="settings-group">
      <view class="settings-item" bindtap="onTapUserCard">
        <view class="settings-left">
          <view class="settings-icon settings-icon-green">✏️</view>
          <view class="settings-info">
            <view class="settings-label">{{locale.settings.editProfile}}</view>
            <view class="settings-desc">{{locale.settings.editProfileDesc}}</view>
          </view>
        </view>
        <view class="settings-right"><text class="settings-arrow">›</text></view>
      </view>

      <view wx:if="{{enablePhoneAuth}}" class="settings-item">
        <view class="settings-left">
          <view class="settings-icon settings-icon-blue">📱</view>
          <view class="settings-info">
            <view class="settings-label">{{locale.settings.phoneAuth}}</view>
            <view class="settings-desc">
              {{userInfo.phone ? (locale.settings.phoneBound + ': ' + userInfo.phone) : locale.settings.phoneAuthDesc}}
            </view>
          </view>
        </view>
        <view class="settings-right">
          <button wx:if="{{!userInfo.phone}}"
            class="phone-btn"
            open-type="getPhoneNumber"
            bindgetphonenumber="onGetPhone">
            {{locale.settings.bindPhone}}
          </button>
          <text wx:else class="settings-value green-text">✓</text>
        </view>
      </view>
    </view>

    <!-- 未配置云环境提醒 -->
    <view wx:if="{{!cloudReady}}" class="settings-group alert-group">
      <view class="settings-item">
        <view class="settings-left">
          <view class="settings-icon settings-icon-orange">⚠️</view>
          <view class="settings-info">
            <view class="settings-label">尚未配置云环境</view>
            <view class="settings-desc">请在 config.js 填写 CLOUD_ENV 以启用真实登录、云同步等功能。详细步骤见 DEPLOY_CHECKLIST.md。</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 偏好设置 -->
    <view class="settings-group">
      <view class="settings-item" bindtap="onOpenLangModal">
        <view class="settings-left">
          <view class="settings-icon settings-icon-green">🌐</view>
          <view class="settings-info">
            <view class="settings-label">{{locale.settings.language}}</view>
            <view class="settings-desc">{{locale.settings.languageDesc}}</view>
          </view>
        </view>
        <view class="settings-right">
          <text class="settings-value lang-value">{{currentLangDisplay}}</text>
          <text class="settings-arrow">›</text>
        </view>
      </view>

      <view class="settings-item">
        <view class="settings-left">
          <view class="settings-icon settings-icon-orange">🎯</view>
          <view class="settings-info">
            <view class="settings-label">{{locale.settings.dailyGoal}}</view>
            <view class="settings-desc">{{locale.settings.dailyGoalDesc}}</view>
          </view>
        </view>
        <view class="settings-right">
          <slider class="goal-slider" min="5" max="120" step="5" value="{{dailyGoal}}"
            activeColor="#2ecc71" block-size="20" bindchange="onChangeDailyGoal" style="width: 180rpx;" />
          <text class="settings-value">{{dailyGoal}}min</text>
        </view>
      </view>

      <view class="settings-item">
        <view class="settings-left">
          <view class="settings-icon settings-icon-blue">🔔</view>
          <view class="settings-info">
            <view class="settings-label">{{locale.settings.notification}}</view>
            <view class="settings-desc">{{locale.settings.notificationDesc}}</view>
          </view>
        </view>
        <view class="settings-right">
          <switch checked="{{notificationEnabled}}" bindchange="onToggleNotification"
            color="#2ecc71" style="transform: scale(0.8);" />
        </view>
      </view>

      <view wx:if="{{notificationEnabled}}" class="settings-item">
        <view class="settings-left">
          <view class="settings-icon settings-icon-purple">⏰</view>
          <view class="settings-info">
            <view class="settings-label">{{locale.settings.reminderTime}}</view>
          </view>
        </view>
        <view class="settings-right">
          <picker mode="time" value="{{reminderTime}}" bindchange="onChangeReminderTime">
            <view class="time-picker">
              <text class="settings-value">{{reminderTime}}</text>
              <text class="settings-arrow">›</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="settings-item" bindtap="onToggleTheme">
        <view class="settings-left">
          <view class="settings-icon settings-icon-blue">🎨</view>
          <view class="settings-info">
            <view class="settings-label">{{locale.settings.theme}}</view>
            <view class="settings-desc">{{locale.settings.themeDesc}}</view>
          </view>
        </view>
        <view class="settings-right">
          <text class="settings-value">{{themeMode === 'light' ? '☀️ Light' : '🌙 Dark'}}</text>
          <text class="settings-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 通用设置 -->
    <view class="settings-group">
      <view class="settings-item" bindtap="onAbout">
        <view class="settings-left">
          <view class="settings-icon settings-icon-green">ℹ️</view>
          <view class="settings-info">
            <view class="settings-label">{{locale.settings.about}}</view>
            <view class="settings-desc">{{locale.settings.aboutDesc}}</view>
          </view>
        </view>
        <view class="settings-right">
          <text class="settings-value">v1.0.0</text>
          <text class="settings-arrow">›</text>
        </view>
      </view>

      <view class="settings-item" bindtap="onPrivacy">
        <view class="settings-left">
          <view class="settings-icon settings-icon-blue">🔒</view>
          <view class="settings-info">
            <view class="settings-label">{{locale.settings.privacy}}</view>
          </view>
        </view>
        <text class="settings-arrow">›</text>
      </view>

      <view class="settings-item" bindtap="onFeedback">
        <view class="settings-left">
          <view class="settings-icon settings-icon-orange">💬</view>
          <view class="settings-info">
            <view class="settings-label">{{locale.settings.feedback}}</view>
          </view>
        </view>
        <text class="settings-arrow">›</text>
      </view>

      <view class="settings-item" bindtap="onClearCache">
        <view class="settings-left">
          <view class="settings-icon settings-icon-red">🗑️</view>
          <view class="settings-info">
            <view class="settings-label">{{locale.settings.clearCache}}</view>
          </view>
        </view>
        <view class="settings-right">
          <text class="settings-value">{{cacheSize}}</text>
          <text class="settings-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 退出登录 -->
    <view wx:if="{{isLoggedIn}}" class="settings-group">
      <view class="settings-item logout-item" bindtap="onLogout">
        <view class="settings-left">
          <view class="settings-icon settings-icon-red">🚪</view>
          <view class="settings-info">
            <view class="settings-label logout-text">{{locale.settings.logout}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 语言支持列表展示 -->
    <view class="lang-support card">
      <view class="card-header">
        <view class="card-title">🌍 Supported Languages</view>
      </view>
      <view class="lang-tags">
        <view class="lang-tag-item" wx:for="{{supportedLangs}}" wx:key="code">
          <text class="lang-tag-native">{{item.native}}</text>
          <text class="lang-tag-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view style="height: 60rpx;"></view>
  </view>

  <!-- 语言选择弹窗 -->
  <view wx:if="{{showLangModal}}" class="modal-mask" bindtap="onCloseLangModal">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">{{locale.settings.selectLang}}</text>
        <view class="modal-close" bindtap="onCloseLangModal">✕</view>
      </view>
      <view class="modal-body">
        <view class="lang-option" wx:for="{{supportedLangs}}" wx:key="code"
          bindtap="onSelectLang" data-code="{{item.code}}">
          <view class="lang-info">
            <view class="lang-flag {{item.code === currentLang ? 'active' : ''}}">
              <text wx:if="{{item.code === 'zh'}}">🇨🇳</text>
              <text wx:elif="{{item.code === 'en'}}">🇺🇸</text>
              <text wx:elif="{{item.code === 'ja'}}">🇯🇵</text>
              <text wx:elif="{{item.code === 'ko'}}">🇰🇷</text>
              <text wx:elif="{{item.code === 'fr'}}">🇫🇷</text>
            </view>
            <view class="lang-text">
              <text class="lang-native">{{item.native}}</text>
              <text class="lang-label">{{item.label}}</text>
            </view>
          </view>
          <view wx:if="{{item.code === currentLang}}" class="lang-check">✓</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 资料编辑弹窗 -->
  <view wx:if="{{showProfileModal}}" class="modal-mask" bindtap="onCloseProfileModal">
    <view class="modal-content profile-modal" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">{{locale.settings.editProfile}}</text>
        <view class="modal-close" bindtap="onCloseProfileModal">✕</view>
      </view>
      <view class="modal-body profile-body">
        <!-- 头像：chooseAvatar（基础库 2.21.2+） -->
        <view class="profile-row">
          <text class="profile-label">Avatar</text>
          <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <block wx:if="{{editAvatarUrl}}">
              <image src="{{editAvatarUrl}}" class="profile-avatar-img" mode="aspectFill" />
            </block>
            <block wx:else>
              <view class="profile-avatar-placeholder">
                <text class="plus">+</text>
              </view>
            </block>
          </button>
        </view>
        <!-- 昵称：type="nickname" input -->
        <view class="profile-row">
          <text class="profile-label">Nickname</text>
          <input class="profile-input"
            type="nickname"
            placeholder="Click to fill in WeChat nickname"
            value="{{editNickName}}"
            bindinput="onNickNameInput"
            bindblur="onNickNameInput"
            maxlength="20" />
        </view>
        <!-- 保存按钮 -->
        <view class="profile-save-row">
          <button class="save-btn" bindtap="onSaveProfile">{{locale.common.confirm}} Save</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 浮动快速朗读按钮 -->
  <view class="fab-mic" bindtap="onGoRead">
    <text class="fab-icon">🎙</text>
  </view>
</view>
