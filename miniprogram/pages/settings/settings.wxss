/* pages/settings/settings.wxss */

.settings-page {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 60rpx;
}

/* ===== 头部区域 ===== */
.header-area {
  padding: 40rpx 32rpx 24rpx;
  background: linear-gradient(180deg, #e8f8ef 0%, var(--bg-page) 100%);
}

.user-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 204, 113, 0.12);
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-color), #27ae60);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(46, 204, 113, 0.35);
}

.avatar-icon {
  font-size: 54rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.user-name.login-text {
  color: var(--primary-color);
}

.user-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-arrow {
  font-size: 40rpx;
  color: var(--text-hint);
  padding-left: 16rpx;
}

.badge {
  background: linear-gradient(135deg, #f39c12, #e67e22);
  color: #ffffff;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  margin-left: 12rpx;
}

/* ===== 设置内容区 ===== */
.settings-content {
  padding: 16rpx 32rpx;
}

.settings-group {
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-color);
  min-height: 88rpx;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.settings-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 32rpx;
  flex-shrink: 0;
}

.settings-icon-green {
  background-color: #e8f8ef;
  color: var(--primary-color);
}

.settings-icon-blue {
  background-color: #e8f4fc;
  color: #3498db;
}

.settings-icon-orange {
  background-color: #fef4e4;
  color: #f39c12;
}

.settings-icon-red {
  background-color: #fdecea;
  color: #e74c3c;
}

.settings-icon-purple {
  background-color: #f3e8ff;
  color: #9b59b6;
}

.settings-icon-gold {
  background: linear-gradient(135deg, #fff4cc, #ffe18a);
  color: #d68e00;
}

/* VIP 入口 */
.vip-entry {
  background: linear-gradient(135deg, rgba(255,244,204,0.18), rgba(255,255,255,1));
}
.vip-label {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 10rpx;
}
.vip-label.pro      { background: linear-gradient(135deg,#f39c12,#d68e00); color:#fff; }
.vip-label.trial    { background: #e3f6ff; color: #2980b9; }
.vip-label.expired  { background: #fdecea; color: #c0392b; }
.ml { margin-left: 10rpx; }

.settings-info {
  flex: 1;
  min-width: 0;
}

.settings-label {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.settings-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
  line-height: 1.4;
}

.settings-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.settings-value {
  font-size: 28rpx;
  color: var(--text-secondary);
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lang-value {
  color: var(--primary-color);
  font-weight: 500;
}

.settings-arrow {
  color: var(--text-hint);
  font-size: 36rpx;
  margin-left: 8rpx;
  line-height: 1;
}

/* 目标滑块 */
.goal-slider {
  margin: 0 12rpx 0 0;
}

/* 时间选择器 */
.time-picker {
  display: flex;
  align-items: center;
}

/* 退出登录 */
.logout-item {
  justify-content: center;
}

.logout-item .settings-left {
  justify-content: center;
  flex: none;
}

.logout-text {
  color: #e74c3c;
  font-weight: 500;
}

/* ===== 语言支持展示区 ===== */
.lang-support {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-header {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.lang-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.lang-tag-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 28rpx;
  background-color: var(--primary-light);
  border-radius: 20rpx;
  min-width: 140rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.lang-tag-item:active {
  border-color: var(--primary-color);
  transform: scale(0.97);
}

.lang-tag-native {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary-dark);
}

.lang-tag-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* ===== 语言选择弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  background-color: var(--bg-page);
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid var(--border-color);
  border-radius: 32rpx 32rpx 0 0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  font-size: 44rpx;
  color: var(--text-hint);
  padding: 0 12rpx;
  line-height: 1;
}

.modal-body {
  padding: 16rpx 0;
  background-color: #ffffff;
}

.lang-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid var(--border-color);
  transition: background-color 0.2s;
}

.lang-option:active {
  background-color: var(--primary-light);
}

.lang-option:last-child {
  border-bottom: none;
}

.lang-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.lang-flag {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background-color: #f5f5f5;
  margin-right: 24rpx;
  transition: all 0.2s;
}

.lang-flag.active {
  background-color: var(--primary-light);
  box-shadow: 0 0 0 2rpx var(--primary-color);
}

.lang-text {
  display: flex;
  flex-direction: column;
}

.lang-native {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.lang-label {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.lang-check {
  color: var(--primary-color);
  font-size: 44rpx;
  font-weight: 700;
}

/* ===== FAB 快速朗读按钮 ===== */
.fab-mic {
  position: fixed;
  right: 40rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 32rpx rgba(46, 204, 113, 0.45);
  z-index: 99;
  animation: fabIn 0.5s ease 0.3s both;
}

.fab-mic:active {
  transform: scale(0.93);
}

.fab-icon {
  font-size: 56rpx;
}

@keyframes fabIn {
  from { opacity: 0; transform: scale(0.5) translateY(20rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

/* ===== 用户卡片：真实头像 / badges ===== */
.avatar-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.user-desc-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.phone-tag {
  color: var(--primary-color);
  font-size: 22rpx;
}

.badge-local {
  background: linear-gradient(135deg, #95a5a6, #7f8c8d);
}

/* ===== 提醒组 ===== */
.alert-group {
  border: 2rpx dashed #f39c12;
  background-color: #fffbf2;
}

.alert-group .settings-info .settings-label {
  color: #e67e22;
}

/* ===== 手机号按钮 ===== */
.phone-btn {
  font-size: 24rpx !important;
  line-height: 56rpx !important;
  height: 56rpx !important;
  padding: 0 24rpx !important;
  background: linear-gradient(135deg, #3498db, #2980b9);
  color: #ffffff !important;
  border-radius: 28rpx !important;
  border: none !important;
  margin: 0 !important;
}

.phone-btn::after { border: none; }

.green-text {
  color: var(--primary-color);
  font-weight: 700;
  font-size: 36rpx !important;
}

/* ===== 资料编辑弹窗 ===== */
.profile-modal {
  max-height: 70vh;
}

.profile-body {
  padding: 32rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.profile-row:last-of-type { border-bottom: none; }

.profile-label {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  flex-shrink: 0;
  width: 160rpx;
}

.avatar-wrapper {
  width: 140rpx !important;
  height: 140rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  border: none !important;
  border-radius: 50% !important;
  line-height: 140rpx !important;
  overflow: hidden;
}

.avatar-wrapper::after { border: none; }

.profile-avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: block;
}

.profile-avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--primary-light);
  border: 2rpx dashed var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-placeholder .plus {
  color: var(--primary-color);
  font-size: 60rpx;
  font-weight: 300;
}

.profile-input {
  flex: 1;
  height: 80rpx;
  background: var(--bg-page);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-left: 16rpx;
}

.profile-save-row {
  padding: 40rpx 0 8rpx;
}

.save-btn {
  width: 100% !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)) !important;
  color: #ffffff !important;
  border-radius: 44rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  border: none !important;
  margin: 0 !important;
}

.save-btn::after { border: none; }
