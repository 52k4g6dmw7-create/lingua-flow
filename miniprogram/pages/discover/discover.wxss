/* pages/discover/discover.wxss */

.discover-page {
  min-height: 100vh;
  background-color: var(--bg-page);
}

/* ===== 搜索栏 ===== */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 20rpx 32rpx 16rpx;
  background-color: var(--bg-page);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 40rpx;
  padding: 0 28rpx;
  height: 80rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  height: 80rpx;
}

/* ===== 滚动内容 ===== */
.page-scroll {
  height: calc(100vh - 120rpx);
}

/* ===== Banner轮播 ===== */
.banner-section {
  padding: 16rpx 32rpx 24rpx;
}

.banner-swiper {
  height: 260rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.banner-card {
  height: 100%;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #ffffff;
}

.banner-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-right: 20rpx;
}

.banner-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.banner-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

.banner-btn-small {
  margin-top: 16rpx;
  display: inline-flex;
  align-self: flex-start;
  padding: 8rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  backdrop-filter: blur(10px);
}

.banner-icon {
  font-size: 110rpx;
  opacity: 0.9;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.15));
}

/* ===== 分类导航 ===== */
.category-section {
  margin-bottom: 8rpx;
}

.category-scroll {
  white-space: nowrap;
  padding: 16rpx 0 16rpx 32rpx;
}

.category-scroll-inner {
  display: inline-flex;
  gap: 20rpx;
  padding-right: 32rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  padding: 24rpx 20rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.category-item.active {
  background: linear-gradient(135deg, var(--primary-light), #ffffff);
  border-color: var(--primary-color);
  transform: translateY(-2rpx);
}

.cat-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.cat-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-primary);
  white-space: nowrap;
}

.category-item.active .cat-label {
  color: var(--primary-dark);
}

/* ===== 通用区块 ===== */
.section {
  padding: 16rpx 0 8rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-more {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* ===== 推荐课程 横滑卡片 ===== */
.course-scroll {
  white-space: nowrap;
  padding-left: 32rpx;
}

.course-scroll-inner {
  display: inline-flex;
  gap: 24rpx;
  padding-right: 32rpx;
}

.course-card {
  width: 480rpx;
  display: inline-block;
  background-color: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s;
}

.course-card:active {
  transform: scale(0.98);
}

.course-cover {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cover-emoji {
  font-size: 80rpx;
}

.diff-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.9);
  color: var(--text-primary);
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.course-info {
  padding: 24rpx;
}

.course-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 12rpx;
  white-space: normal;
}

.course-meta {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 16rpx;
}

.course-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.students {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.enroll-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #ffffff;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== 热门课程列表 ===== */
.list-courses {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.list-course-item {
  display: flex;
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  padding: 20rpx;
  gap: 20rpx;
}

.list-course-item:active {
  background-color: #fafafa;
}

.list-cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
}

.list-emoji {
  font-size: 64rpx;
}

.hot-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  padding: 4rpx 12rpx;
  background-color: #e74c3c;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.list-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.list-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
}

.list-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 0;
  flex-wrap: wrap;
}

.diff-tag-sm {
  padding: 4rpx 14rpx;
  background-color: var(--primary-light);
  color: var(--primary-dark);
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.list-meta {
  font-size: 22rpx;
  color: var(--text-hint);
}

.list-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.list-students {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.enroll-btn-sm {
  padding: 10rpx 22rpx;
  background-color: var(--primary-light);
  color: var(--primary-dark);
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== 最新上架 网格 ===== */
.grid-courses {
  padding: 0 32rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.grid-course-item {
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.grid-course-item:active {
  transform: scale(0.97);
}

.grid-cover {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.grid-emoji {
  font-size: 72rpx;
}

.new-ribbon {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 4rpx 14rpx;
  background: linear-gradient(135deg, #f39c12, #e67e22);
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 18rpx;
  font-weight: 700;
}

.grid-info {
  padding: 20rpx;
}

.grid-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.grid-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

.diff-mini {
  color: var(--primary-dark);
  font-weight: 500;
}

/* ===== FAB 快速朗读按钮 ===== */
.fab-mic {
  position: fixed;
  right: 40rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 32rpx rgba(46, 204, 113, 0.45);
  z-index: 99;
  animation: fabIn 0.5s ease 0.3s both;
}

.fab-mic:active {
  transform: scale(0.93);
}

.fab-icon {
  font-size: 56rpx;
}

@keyframes fabIn {
  from { opacity: 0; transform: scale(0.5) translateY(20rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
